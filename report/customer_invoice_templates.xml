<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_customer_invoice_template" name="Customer Invoice Template">
        <t t-call="web.html_container">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <title>Invoice Report</title>
                <style type="text/css">
                    .page {
                        border: 1px solid #000;
                        padding: 20px;
                        margin: 20px;
                        min-height: 150vh; /* Ensure full viewport height */
                        font-size: 18px;
                    }
                    table {
                        width: 100%;
                        border-collapse: collapse;
                        text-align: center;
                        font-size: 18px;
                        margin: 0 auto;
                    }
                    th, td {
                        border: 1px solid #ddd;
                        padding: 8px;
                    }
                    th {
                        background-color: #f4f4f4;
                        font-weight: bold;
                    }
                </style>
            </head>
            <body style="font-size: 14px; color: #000; margin: 20px; padding: 0;">
                <main>
                    <t t-foreach="docs" t-as="doc">
                        <div class="page">
                            <!-- Header Section -->
                            <div class="header-section" style="text-align: center; padding-bottom: 20px; 
                                border-bottom: 1px solid #000; position: relative;">
                                <img t-att-src="'http://localhost:8069/vighnahar_agro/static/src/img/logo.png'" 
                                     alt="Logo" style="max-height: 100px; max-width: 150px; position: absolute; left: 0px;"/>
                                <h3>श्री विघ्नहर प्रसन्न</h3>
                                <h1>विघ्नहर ॲग्रो</h1>
                                <div style="position: absolute; right:0px; bottom:25; font-size:16px;">
                                    <h3>श्री वैभव व्ही. कवडे</h3>
                                    <p >मोबाईल: ९७६६५१२२३८, ८७६७२०००००</p>
                                    <p>पोस्ट: ओझर, ता - जुन्नर, जिल्हा - पुणे</p>
                                </div>
                            </div>
                            
                            <!-- Invoice Details Section -->
                            <div class="invoice-details" style="padding: 20px 0; border-bottom: 1px solid #000;">
                                <p>पार्टी नाव: <strong><t t-esc="doc.party_id.name"/></strong></p>
                                <p>चालान क्रमांक: <strong><t t-esc="doc.name"/></strong></p>
                                <p>तारीख: <strong><t t-esc="doc.date"/></strong></p>
                            </div>
                            
                            <!-- Product Table Section -->
                            <div class="product-table" style="padding: 20px 0;">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>उत्पादन</th>
                                            <th>प्रमाण</th>
                                            <th>एकक</th>
                                            <th>किंमत</th>
                                            <th>एकूण</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="doc.customer_invoice_line_ids" t-as="line">
                                            <tr>
                                                <td><t t-esc="line.product_id.name"/></td>
                                                <td><t t-esc="line.quantity"/></td>
                                                <td><t t-esc="line.uom_id.name"/></td>
                                                <td><t t-esc="line.price"/></td>
                                                <td><t t-esc="line.total"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Total Amount Section -->
                            <div class="total-amount" style="text-align: right; margin-top: 20px; font-weight: bold;">
                                <p><strong>एकूण रक्कम: <t t-esc="doc.total_amount"/></strong></p>
                            </div>
                            
                            <!-- Footer Section -->
                            <div class="footer-section" style="border-top: 1px solid #000; font-weight:bold;
                                 margin-top:100px; width: 100%;">
                                <p style="text-align: left;">धन्यवाद!</p>
                                <p style="text-align: right;">स्वाक्षरी</p>
                            </div>
                        </div>
                    </t>
                </main>
            </body>
        </t>
    </template>
</odoo>
