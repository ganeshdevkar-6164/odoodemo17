<odoo>
    <data>
<!-- Party View-->
        <record id="view_party_form" model="ir.ui.view">
            <field name="name">party.form</field>
            <field name="model">vighnahar_agro.party</field>
            <field name="arch" type="xml">
                <form string="Party">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>                                
                                <field name="registration_date"/>
                                <field name="is_supplier" widget="checkbox"/>
                                <field name="is_customer" widget="checkbox"/>
                                <field name="party_type"/>
                            </group>
                            <group>
                                <group>
                                    <field name="documents" filename = "documents_name"/>
                                    <field name="documents_name" invisible = "1"/>
                                </group>
                                <group>
                                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                                </group>
                            </group>
                        </group>
                        <notebook>
                            <page string = "Personal Information">
                                <form>
                                    <group>
                                        <group>
                                            <field name="address" required="1"/>
                                            <field name="city" required="1"/>
                                            <field name="state_id"/>
                                            <field name="zip_code"/>
                                            <field name="country_id"/>                                           
                                        </group>
                                        <group>
                                            <field name="contact" required="1"/>
                                            <field name="optional_contact"/>
                                            <field name="email"/>
                                            <field name="website"/>
                                            <field name="description"/>
                                        </group>
                                    </group>
                                </form>
                            </page>
                            <page string = "Farm Details" invisible="party_type != 'farmer'">
                                <field name="farm_details_ids" widget="one2many_list"  >
                                    <tree editable="bottom">
                                        <field name="name"/> 
                                        <field name="farm_location"/>
                                        <field name="farm_area"/>
                                        <field name="primary_uom"/>
                                        <field name="farm_area1"/>
                                        <field name="secondary_uom"/>
                                        <field name="farm_area2"/>
                                        <field name="conversion_uom"/>                                       
                                        <field name="coordinates"/>
                                        <field name="view_location" readonly="1" widget="url"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>   
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_party_kanban" model="ir.ui.view">
            <field name="name">party.kanban</field>
            <field name="model">vighnahar_agro.party</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <kanban class="o_party_kanban">
                    <field name="name"/>
                    <field name="registration_date"/>
                    <field name="address"/>
                    <field name="contact"/>
                    <field name="email"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_party_kanban_record">                
                                <t t-if="record.image.raw_value">
                                    <field name="image" class="o_kanban_image_fill_left d-block" 
                                        widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}"/>
                                </t>
                                <div t-else="" class="o_kanban_image_fill_left d-flex align-items-center justify-content-center bg-100 bg-gradient">
                                    <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <g fill="currentColor">
                                            <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                            <circle cx="10" cy="5.5" r="4.5"/>
                                        </g>
                                    </svg>
                                </div>
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name" placeholder="Party Name"/>
                                            </strong>
                                            <!-- <span t-if="record.registration_date.raw_value" class="o_kanban_record_subtitle">
                                                <field name="registration_date"/>
                                            </span> -->
                                        </div>
                                    </div>
                                    <ul>
                                        <li t-if="record.registration_date.raw_value" class="o_force_ltr">
                                            <i class="fas fa-fw me-2 fa-calendar-alt" title="Registration Date"/>
                                            <field name="registration_date"/>
                                        </li>

                                        <li t-if="record.address.raw_value" class="o_text_overflow">
                                            <i class="fa fa-fw me-2 fa-location-arrow text-primary" title="Address"/>
                                            <field name="address"/>
                                        </li>
                                        <li t-if="record.contact.raw_value" class="o_force_ltr">
                                            <i class="fa fa-fw me-2 fa-phone text-primary" title="Contact"/>
                                            <field name="contact"/>
                                        </li>
                                        <li t-if="record.email.raw_value" class="o_text_overflow">
                                            <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                                            <field name="email"/>
                                        </li>    
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>



        <record id="view_party_tree" model="ir.ui.view">
            <field name="name">party.tree</field>
            <field name="model">vighnahar_agro.party</field>
            <field name="arch" type="xml">
                <tree string="Party">
                    <field name="name"/>
                    <field name="registration_date"/>
                    <field name="address" required="1"/>
                    <field name="contact" required="1"/>
                    <field name="email"/>
                </tree>
            </field>
        </record>

        <record id="action_party_form" model="ir.actions.act_window">
            <field name="name">Party</field>
            <field name="res_model">vighnahar_agro.party</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="view_id" ref="view_party_kanban"/>
        </record>

        <menuitem id="menu_party" name="Party" parent="menu_vighnahar_agro" action="action_party_form" sequence="2"/>

    </data>
</odoo>