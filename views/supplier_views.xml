<odoo>
    <!-- Supplier Registration Form View -->
    <record id="view_supplier_registration_form" model="ir.ui.view">
        <field name="name">supplier.registration.form</field>
        <field name="model">supplier.registration</field>
        <field name="arch" type="xml">
            <form string="Supplier Registration">
                <header>
                    <button name="action_confirm" string="Register Supplier" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,register,cancelled"/>
                </header>
                <sheet>
                    
                    <!-- First Half of the Form -->
                    <group>
                        <group>
                            <field name="id"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                        </group>

                        <!-- Second Half of the Form -->
                        <group>
                            <field name="supplier_type" widget="radio" />
                            <field name="registration_date"/>
                            <field name="company_id"/>
                            <field name="document_type"/>
                            <field name="document_file" widget="binary"/>
                        </group>
                    </group>

                    <!-- Tabs for additional details -->
                    <notebook>
                        <!-- Land Details Tab -->
                        <page string="Land Details">
                            <field name="land_ids">
                                <tree editable="bottom">
                                    <field name="land_location"/>
                                    <field name="land_size"/>
                                    <field name="category_id" optional="hide"/>
                                    <field name="uom_id"/>
                                    <field name="land_type"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Supplier Registration List View -->
    <record id="view_supplier_registration_tree" model="ir.ui.view">
        <field name="name">supplier.registration.tree</field>
        <field name="model">supplier.registration</field>
        <field name="arch" type="xml">
            <tree string="Supplier List">
                <field name="id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="supplier_type"/>
                <field name="registration_date"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <!-- Action to Open Supplier Registration Form -->
    <record id="action_supplier_registration" model="ir.actions.act_window">
        <field name="name">Supplier Registration</field>
        <field name="res_model">supplier.registration</field>
        <field name="view_mode">tree,form</field>  <!-- Allow both form and list views -->
        <field name="target">current</field>
    </record>

    <!-- Menu Item for Custom UOM Configuration -->
    <menuitem id="agro_company_config" parent="agro_company_menu" name="Configuration" sequence="6"/>

    <!-- Submenu Item for Supplier Registration -->
    <menuitem id="supplier_registration_menu" name="Supplier" parent="agro_company_config" action="action_supplier_registration" sequence="4"/>
</odoo>
