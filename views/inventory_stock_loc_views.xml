<odoo>
    <!-- Warehouse Views for custom.inventory.warehouse -->
    <record id="view_warehouse_tree" model="ir.ui.view">
        <field name="name">custom.inventory.warehouse.tree</field>
        <field name="model">custom.inventory.warehouse</field>
        <field name="arch" type="xml">
            <tree string="Warehouses">
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="view_warehouse_form" model="ir.ui.view">
        <field name="name">custom.inventory.warehouse.form</field>
        <field name="model">custom.inventory.warehouse</field>
        <field name="arch" type="xml">
            <form string="Warehouse">
                <sheet>
                    <group>
                        <field name="name" string="Warehouse Name" required="1"/>
                        <field name="code" string="Warehouse Code" required="1"/>
                    </group>
                    <group>
                        <field name="address" string="Address"/>
                        <field name="description" string="Description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions for custom.inventory.warehouse -->
    <record id="action_warehouse" model="ir.actions.act_window">
        <field name="name">Warehouses</field>
        <field name="res_model">custom.inventory.warehouse</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items for custom.inventory.warehouse -->
    <menuitem id="menu_warehouse" name="Warehouse Location" parent="agro_company_config" action="action_warehouse" sequence="1"/>

    <!-- Warehouse Views for sub.inventory.warehouse (Sub Inventory) -->
    <record id="view_sub_inventory_warehouse_tree" model="ir.ui.view">
        <field name="name">sub.inventory.warehouse.tree</field>
        <field name="model">sub.inventory.warehouse</field>
        <field name="arch" type="xml">
            <tree string="Sub Inventory">
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Sub Inventory Warehouse Form View -->
    <record id="view_sub_inventory_warehouse_form" model="ir.ui.view">
        <field name="name">sub.inventory.warehouse.form</field>
        <field name="model">sub.inventory.warehouse</field>
        <field name="arch" type="xml">
            <form string="Sub Inventory">
                <sheet> 
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="address"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions for sub.inventory.warehouse -->
    <record id="action_sub_inventory_warehouse" model="ir.actions.act_window">
        <field name="name">Sub Inventory Warehouses</field>
        <field name="res_model">sub.inventory.warehouse</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items for sub.inventory.warehouse -->
    <menuitem id="menu_sub_inventory_warehouse" name="Sub Inventory Location" parent="agro_company_config" action="action_sub_inventory_warehouse" sequence="2"/>
</odoo>
