<odoo>
    <data>

        <!-- Tax form view -->
        <record id="view_vighnahar_agro_account_tax_form" model="ir.ui.view">
            <field name="name">vighnahar_agro.account_tax.form</field>
            <field name="model">vighnahar_agro.account_tax</field>
            <field name="arch" type="xml">
                <form string="Tax">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="type_tax_use"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tax tree view -->
        <record id="view_vighnahar_agro_account_tax_tree" model="ir.ui.view">
            <field name="name">vighnahar_agro.account_tax.tree</field>
            <field name="model">vighnahar_agro.account_tax</field>
            <field name="arch" type="xml">
                <tree string="Taxes">
                    <field name="name"/>
                    <field name="amount"/>
                    <field name="type_tax_use"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Action for tax menu -->
        <record id="action_vighnahar_agro_account_tax" model="ir.actions.act_window">
            <field name="name">Taxes</field>
            <field name="res_model">vighnahar_agro.account_tax</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_vighnahar_agro_account_tax_tree"/>
        </record>

        <!-- Tax menu item -->
        <menuitem id="vighnahar_agro_account_tax_menu" name="Taxes" parent="menu_configuration" action="action_vighnahar_agro_account_tax"/>
        
    </data>
</odoo>
