<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.form</field>
        <field name="model">vighnahar_agro.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="code"/>
                            
                        </group>
                        <group>
                           
                            <field name="account_type"/>
                            
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_tree" model="ir.ui.view">
        <field name="name">account.tree</field>
        <field name="model">vighnahar_agro.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="code"/>
                <field name="account_type"/>
                
            </tree>
        </field>
    </record>

    <record id="action_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">vighnahar_agro.account</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_account" name="Accounts" parent="menu_accounting" action="action_account"/>


    <record id="view_journal_form" model="ir.ui.view">
        <field name="name">journal.form</field>
        <field name="model">vighnahar_agro.journal</field>
        <field name="arch" type="xml">
            <form string="Journal">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="type"/>
                        <field name="account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_journal_tree" model="ir.ui.view">
        <field name="name">journal.tree</field>
        <field name="model">vighnahar_agro.journal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="account_id"/>      
            </tree>
        </field>
    </record>

    <record id="action_journal" model="ir.actions.act_window">
        <field name="name">Journals</field>
        <field name="res_model">vighnahar_agro.journal</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_journal" name="Journals" parent="menu_accounting" action="action_journal"/>



    <!-- Journal Entry Form View -->
    <record id="view_journal_entry_form" model="ir.ui.view">
        <field name="name">journal_entry.form</field>
        <field name="model">vighnahar_agro.journal_entry</field>
        <field name="arch" type="xml">
            <form string="Journal Entry">
                <header>
                    <button name="post_entry" string="Post" type="object" class="oe_highlight" 
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="journal_id"/>
                            
                        </group>
                    </group>
                    <notebook>
                        <page string="Journal Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="account_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Journal Entry Tree View -->
    <record id="view_journal_entry_tree" model="ir.ui.view">
        <field name="name">journal_entry.tree</field>
        <field name="model">vighnahar_agro.journal_entry</field>
        <field name="arch" type="xml">
            <tree string="Journal Entries">
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Journal Entries Action -->
    <record id="action_journal_entry" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">vighnahar_agro.journal_entry</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item for Journal Entries -->
    <menuitem id="menu_journal_entry" name="Journal Entries" parent="menu_accounting" action="action_journal_entry"/>
</odoo>
