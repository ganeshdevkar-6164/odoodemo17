<odoo>
    <!-- Supplier Invoice Form -->
    <record id="view_supplier_invoice_form" model="ir.ui.view">
        <field name="name">supplier_invoice.form</field>
        <field name="model">vighnahar_agro.supplier_invoice</field>
        <field name="arch" type="xml">
            <form string="Supplier Invoice">
                <header>
                    <!-- Buttons -->
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"
                        invisible="state != 'draft'" />
                    <button name="action_register_payment" type="object" string="Register Payment" class="oe_highlight"
                        invisible="payment_status == 'paid' or state != 'post'" />
                    <!-- <button name="action_cancel" type="object" string="Cancel" invisible="state != 'post'" /> -->
                    
                    <!-- Add Status Bar for Invoice Status -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,post"/>
                    <!-- <field name="payment_status" widget="statusbar" statusbar_visible="pending,fully_paid,partially_paid"/> -->
                </header>

                <sheet>
                    <!-- Using Standard Odoo Ribbons -->
                    <!-- <div class="o_form_invisible_fields" style="position: absolute; right: 10px; top: 10px;"> -->
                    <!-- Paid Ribbon -->
                    <widget name="web_ribbon" title="Paid" 
                        invisible="payment_status != 'paid'" 
                        bg_color="text-bg-success" />
                    <!-- Partial Payment Ribbon -->
                    <widget name="web_ribbon" title="Partial" 
                        invisible="payment_status != 'partial'" 
                        bg_color="text-bg-info" />
                    <!-- Pending Payment Ribbon -->
                    <widget name="web_ribbon" title="Pending" 
                        invisible="payment_status != 'pending' or state != 'post'" 
                        bg_color="text-bg-warning" />
                    <!-- </div> -->
                    <group>
                        <group>
                            <field name="name"/>                            
                            <field name="party_id" domain="[('is_supplier', '=', True)]"/>
                            <field name="description"/>
                            <!-- <field name="is_labor"/> -->
                        </group>                                                                                                                                                                                                         
                        <group>                                     
                            <field name="date"/>  
                            <!-- Warehouse visibility conditional on is_labor -->
                            <field name="warehouse_id"/>                            
                            <field name="journal_id"/>                      
                            <!-- <field name="total_amount" readonly="1"/> -->
                            <!-- <field name="total_tax_amount" readonly="1"/>            -->
                            <field name="payment_status" invisible="1"/>
                            
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines">
                            <field name="supplier_invoice_line_ids">
                                <tree editable="bottom">
                                    <field name="product_category_id" string="Product Category" domain="[('id', 'in', available_product_category_ids)]"/>
                                    <field name="product_id" string="Product"/>
                                    <field name="quantity" string="Quantity"/>
                                    <field name="uom_id" string="UOM"/>
                                    <field name="converted_quantity" string="Converted Quantity" optional="hide"/>
                                    <field name="converted_uom_id" string="Converted UOM" optional="hide"/>
                                    <field name="price" string="Unit Price"/>
                                    <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="tax_excluded_amount" readonly="1" string="Tax excluded"/>
                                    <field name="tax_amount" optional="hide"/>
                                    <field name="tax_included_amount" optional="hide" string="Tax Included"/>
                                    <!-- <field name="total" string="Total Price" readonly="1"/> -->
                                    <field name="uom_category_id" string="UOM Category" optional="hide"/>
                                    <field name="available_product_category_ids" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Journal Items">
                            <field name="journal_item_ids" widget="one2many_list">
                                <tree editable="bottom">
                                    <field name="account_id"/>
                                    <field name="product_id" string="Label"/>
                                    <!-- <field name="party_id"/> -->
                                    <field name="debit" sum="debit"/>
                                    <field name="credit" sum="credit"/>
                                    <field name="tax_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <div style="text-align: right; padding-top: 5px;">
                        <div invisible="not has_tax_lines">Untaxed Amount: <strong><field name="total_amount_tax_excluded"/></strong></div>
                        <div invisible="not has_tax_lines">Tax Amount: <strong><field name="tax_amount"/></strong></div>
                        <div>Total: <strong><field name="total_amount_tax_included"/></strong></div>
                        <div invisible="amount_due == 0.0 or state != 'post'">Amount Due: <strong><field name="amount_due"/></strong></div>
                        <div invisible="paid_amount == 0.0">Paid Amount: <strong><field name="paid_amount"/></strong></div>
                    </div>
                    <!-- Include the computed field but make it invisible -->
                    <field name="has_tax_lines" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Supplier Invoice Tree -->
    <record id="view_supplier_invoice_tree" model="ir.ui.view">
        <field name="name">supplier_invoice.tree</field>
        <field name="model">vighnahar_agro.supplier_invoice</field>
        <field name="arch" type="xml">
            <tree string="Supplier Invoices" default_order="id desc">
                <field name="name" string="Name"/>
                <field name="party_id" string="Party/Supplier"/>
                <field name="date" string="Date"/>
                <field name="warehouse_id"/>
                <field name="state"/>
                <field name="total_amount" string="Total Amount" sum="Total Amount"/>
                <field name="payment_status" string="Payment Status" widget="badge" decoration-success="payment_status == 'paid'"
                 decoration-info="payment_status == 'partial'" decoration-warning="payment_status == 'pending'"/>
            </tree>
            
        </field>
    </record>

    <!-- Action for Supplier Invoice -->
    <record id="action_supplier_invoice" model="ir.actions.act_window">
        <field name="name">Supplier Invoices</field>
        <field name="res_model">vighnahar_agro.supplier_invoice</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_supplier_invoice" name="Supplier Invoices" parent="menu_supplier" action="action_supplier_invoice"/>

    <!-- Supplier Payment Tree View -->
    <record id="view_supplier_payment_tree" model="ir.ui.view">
        <field name="name">supplier.payment.tree</field>
        <field name="model">vighnahar_agro.supplier_payment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="payment_date"/>
                
                <field name="payment_method"/>
                <field name="invoice_id"/>
                <field name="amount" sum="Amount"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"
                                                   decoration-info="state == 'draft'"/>
                <field name="utr_number"/>
            </tree>
        </field>
    </record>

    <!-- Supplier Payment Form View -->
    <record id="view_supplier_payment_form" model="ir.ui.view">
        <field name="name">supplier.payment.form</field>
        <field name="model">vighnahar_agro.supplier_payment</field>
        <field name="arch" type="xml">
            <form string="Supplier Payment">
                <header>
                    <button name="action_pay" string="Create Payment" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Paid" 
                        invisible="state != 'paid'" 
                        bg_color="text-bg-success" />
                    <widget name="web_ribbon" title="Cancelled" 
                        invisible="state != 'cancel'" 
                        bg_color="text-bg-danger" />
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="payment_date"/>
                            <field name="amount"/>
                            <field name="bank_account_id" invisible="payment_method not in ('bank', 'online')" />
                            
                        </group>
                        <group>
                            <field name="party_id"/>
                            <field name="payment_method"/>
                            <field name="invoice_id" string="Memo" readonly="1"/>
                            
                        </group> 
                    </group>
                </sheet>
                
            </form>
        </field>
    </record>

    <!-- Action for Supplier Payments -->
    <record id="action_supplier_payment" model="ir.actions.act_window">
        <field name="name">Supplier Payments</field>
        <field name="res_model">vighnahar_agro.supplier_payment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_supplier_payment" name="Supplier Payments" parent="menu_supplier" action="action_supplier_payment"/>

    <record id="view_supplier_payment_qr_wizard_form" model="ir.ui.view">
        <field name="name">supplier.payment.qr.wizard.form</field>
        <field name="model">vighnahar_agro.supplier_payment_qr_wizard</field>
        <field name="arch" type="xml">
            <form string="UPI Payment QR Code">
                <group>
                    <field name="qr_code_image" widget='image' readonly="1"/>
                    <field name="amount" readonly="1"/>
                    <field name="utr_number"/>
                </group>
                <footer>
                    <!-- Done Button to mark the payment as 'paid' -->
                    <button string="Done" type="object" name="action_done" class="btn-primary"/>
                    <!-- Cancel Button to close the wizard -->
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="view_supplier_payment_bank_wizard_form" model="ir.ui.view">
        <field name="name">supplier.payment.bank.wizard.form</field>
        <field name="model">vighnahar_agro.supplier_payment_bank_wizard</field>
        <field name="arch" type="xml">
            <form string="Bank Payment Details" window_title="">
                <group>
                    <group>
                        <field name="payment_id" readonly="1"/>
                        <field name="invoice_number"/>
                        <field name="amount"/>
                        <field name="bank_holder_name"/>
                    </group>
                    <group>
                        <field name="bank_name"/>
                        <field name="account_number"/>
                        
                        <field name="branch"/>
                        <field name="ifsc_code"/>
                    </group>
                </group>
                <footer>
                    <button name="action_done" type="object" string="Done" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
