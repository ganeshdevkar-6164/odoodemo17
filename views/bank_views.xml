<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Banks Tree View -->
    <record id="view_banks_tree" model="ir.ui.view">
        <field name="name">banks.tree</field>
        <field name="model">vighnahar_agro.banks</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
            </tree>
        </field>
    </record>

    <!-- Banks Form View -->
    <record id="view_banks_form" model="ir.ui.view">
        <field name="name">banks.form</field>
        <field name="model">vighnahar_agro.banks</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    

    <!-- Banks Action -->
    <record id="action_banks" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">vighnahar_agro.banks</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bank" name="Bank" parent="menu_configuration" action="action_banks" sequence="5"/>



    <!-- Bank Accounts Tree View -->
    <record id="view_bank_account_tree" model="ir.ui.view">
        <field name="name">bank_account.tree</field>
        <field name="model">vighnahar_agro.bank_account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="banks_id"/>
                <field name="party_id"/>
            </tree>
        </field>
    </record>

    <!-- Bank Accounts Form View -->
    <record id="view_bank_account_form" model="ir.ui.view">
        <field name="name">bank_account.form</field>
        <field name="model">vighnahar_agro.bank_account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="banks_id"/>
                        <field name="party_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bank Accounts Action -->
    <record id="action_bank_account" model="ir.actions.act_window">
        <field name="name">Bank Account</field>
        <field name="res_model">vighnahar_agro.bank_account</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bank_account" name="Bank Accounts" parent="menu_configuration" action="action_bank_account" sequence="6"/>

</odoo>