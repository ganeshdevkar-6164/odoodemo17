<odoo>
    <!-- Form View for Inventory Transfer -->
    <record id="view_inventory_transfer_form" model="ir.ui.view">
        <field name="name">inventory.transfer.form</field>
        <field name="model">custom.inventory.transfer</field>
        <field name="arch" type="xml">
            <form string="Inventory Transfer">
                <header>
                    <!-- Confirm Transfer Button - Invisible when state is 'confirmed' -->
                    <button string="Confirm Transfer" type="object" name="confirm_transfer" class="oe_highlight"
                        invisible="state == 'confirmed'" />
                    
                    <!-- State Field in Header -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,"
                           class="oe_inline" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_warehouse_id"/>
                        <field name="destination_warehouse_id"/>
                        <field name="transfer_date"/>
                        <!-- <field name="state" readonly="1"/> -->
                    </group>
                    <notebook>
                        <page string="Transfer Lines">
                            <field name="transfer_line_ids">
                                <tree editable="bottom">
                                    <field name="product_category_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View for Inventory Transfer -->
    <record id="view_inventory_transfer_tree" model="ir.ui.view">
        <field name="name">inventory.transfer.tree</field>
        <field name="model">custom.inventory.transfer</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="source_warehouse_id"/>
                <field name="destination_warehouse_id"/>
                <field name="transfer_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Action to trigger the Inventory Transfer Wizard -->
    <record id="action_inventory_transfer" model="ir.actions.act_window">
        <field name="name">Inventory Transfer</field>
        <field name="res_model">custom.inventory.transfer</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_inventory_transfer_tree"/> <!-- Explicitly set tree view as the default -->
    </record>


    <!-- Menu item for accessing Inventory Transfers -->
    <menuitem id="menu_custom_inventory" name="Inventory" parent="agro_company_menu" sequence="4"/>
    <menuitem id="menu_inventory_transfer" name="Inventory Transfer" parent="menu_custom_inventory" action="action_inventory_transfer" sequence="2"/>
</odoo>
