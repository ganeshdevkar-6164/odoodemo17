<odoo>

    <!-- Views for Purchase Order (Form View) -->
    <record id="view_purchase_order_form_custom" model="ir.ui.view">
        <field name="name">purchase.order.custom.form</field>
        <field name="model">purchase.order.custom</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_link" invisible="state != 'purchase_order'"/>
                    <!-- <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="oe_link" invisible="state != 'cancelled'"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,purchase_order,cancelled"/>
                </header>
                    <field name="loan_found" invisible="1"/>
                <sheet>
                    <!-- Smart Buttons in a box -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_loan_details" type="object" string="Loan Details" class="oe_stat_button bg-red" icon="fa-credit-card" invisible="not loan_found"/>
                        <button name="action_create_receipt" type="object" string="Receipt" class="oe_stat_button" icon="fa-truck" invisible="state != 'purchase_order'"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="supplier_id"/>
                            <field name="wh_loc_id"/>
                            <field name="date_order"/>
                        </group>
                        <group>
                            <field name="remaining_loan"/>
                            <field name="deduct_loan_amount"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line">
                                <tree editable="bottom">
                                    <field name="product_category_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Supplier Property Details">
                            <field name="land_ids">
                                <tree editable="bottom">
                                    <field name="land_location"/>
                                    <field name="category_id" optional="hide"/>
                                    <field name="land_size"/>
                                    <field name="uom_id"/>
                                    <field name="land_type"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Views for Purchase Order Tree/List -->
    <record id="view_purchase_order_tree_custom" model="ir.ui.view">
        <field name="name">purchase.order.custom.tree</field>
        <field name="model">purchase.order.custom</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="wh_loc_id"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="amount_total"/>
            </tree>
        </field>
    </record>

    <!-- Views for Purchase Receipt (Form View) -->
    <record id="view_receipt_form_custom" model="ir.ui.view">
        <field name="name">receipt.custom.form</field>
        <field name="model">receipt.custom</field>
        <field name="arch" type="xml">
            <form string="Receipt">
                <header>
                    <button name="action_receive" string="Receive" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,cancelled"/>
                </header>
                <sheet>
                    <!-- Smart Buttons in a box -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_invoice" type="object" string="Invoice" class="oe_stat_button" icon="fa-truck" invisible="state != 'received'"/>  
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="purchase_order_id"/>
                        <field name="receipt_date"/>
                        <!-- <field name="state"/> -->
                        <field name="supplier_id"/>
                        <field name="wh_loc_id"/>
                    </group>
                    <notebook>
                        <page string="Receipt Lines">
                            <field name="order_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="product_category_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Views for Purchase Receipt Tree/List -->
    <record id="view_receipt_tree_custom" model="ir.ui.view">
        <field name="name">receipt.custom.tree</field>
        <field name="model">receipt.custom</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="receipt_date"/>
                <field name="state"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <!-- Views for Purchase Invoice (Form View) -->
    <record id="view_purchase_invoice_form_custom" model="ir.ui.view">
        <field name="name">purchase.invoice.custom.form</field>
        <field name="model">purchase.invoice.custom</field>
        <field name="arch" type="xml">
            <form string="Purchase Invoice">
                <header>
                    <button name="action_post" string="Register Payment" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <!-- <button name="action_create_payment" string="Register Payment" type="object" class="oe_highlight" invisible="state != 'posted'"/> -->
                    <button name="action_cancel" string="Cancel" type="object" class="oe_link" invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_payment" type="object" string="Payment" class="oe_stat_button" icon="fa-truck" invisible="state != 'posted'"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="purchase_order_id"/>
                        <field name="total_amount"/>
                        <field name="supplier_id"/>
                        <field name="wh_loc_id"/>
                        <field name="invoice_date"/>
                        <!-- <field name="state"/> -->
                    </group>
                    <notebook>
                        <page string="Invoice Lines">
                            <field name="order_line_ids" nolabel="1">
                                <tree> 
                                    <field name="product_category_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Views for Purchase Invoice Tree/List -->
    <record id="view_purchase_invoice_tree_custom" model="ir.ui.view">
        <field name="name">purchase.invoice.custom.tree</field>
        <field name="model">purchase.invoice.custom</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="purchase_order_id"/>
                <field name="total_amount"/>
                <field name="invoice_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Views for Purchase Payment (Form View) -->
    <record id="view_purchase_payment_form_custom" model="ir.ui.view">
        <field name="name">purchase.payment.custom.form</field>
        <field name="model">purchase.payment.custom</field>
        <field name="arch" type="xml">
            <form string="Purchase Payment">
                <header>
                    <button name="action_post" string="Pay" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="invoice_id"/>
                        <field name="payment_date"/>
                        <field name="amount"/>
                        <field name="supplier_id"/>
                        <field name="wh_loc_id"/>
                        <!-- <field name="state"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Views for Purchase Payment Tree/List -->
    <record id="view_purchase_payment_tree_custom" model="ir.ui.view">
        <field name="name">purchase.payment.custom.tree</field>
        <field name="model">purchase.payment.custom</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="agro_company_menu" name="Agro Company" sequence="1"/>
    <menuitem id="purchase_order_custom_menu" name="Purchase Orders" parent="agro_company_menu" sequence="3"/>

    <!-- Action for Purchase Order -->
    <record id="action_purchase_order_custom" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order.custom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Purchase Receipt -->
    <record id="action_receipt_custom" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">receipt.custom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Purchase Invoice -->
    <record id="action_invoice_custom" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">purchase.invoice.custom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Purchase Payment -->
    <record id="action_payment_custom" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">purchase.payment.custom</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Linking Menu to Actions -->
    <menuitem id="menu_purchase_order_custom" name="Purchase Orders" parent="purchase_order_custom_menu" action="action_purchase_order_custom" sequence="10"/>
    <menuitem id="menu_purchase_receipt_custom" name="Receipts" parent="purchase_order_custom_menu" action="action_receipt_custom" sequence="20"/>
    <menuitem id="menu_purchase_invoice_custom" name="Invoices" parent="purchase_order_custom_menu" action="action_invoice_custom" sequence="30"/>
    <menuitem id="menu_purchase_payment_custom" name="Payments" parent="purchase_order_custom_menu" action="action_payment_custom" sequence="40"/>

</odoo>
