<odoo>
    <!-- Resource Share Form View -->
    <record id="view_custom_resource_share_form" model="ir.ui.view">
        <field name="name">custom.resource.share.form</field>
        <field name="model">custom.resource.share</field>
        <field name="arch" type="xml">
            <form string="Resource Share">
                <header>
                    <!-- Confirm Button -->
                    <button name="confirm_resource" string="Confirm" type="object" class="btn-primary" 
                            invisible="not (state == 'draft')"/>
                    
                    <!-- Create Loan Button -->
                    <button name="create_loan" string="Create Loan" type="object" class="btn-warning" 
                            invisible="not (state == 'confirmed')"/>
                    
                    <!-- Make Payment Button -->
                    <button name="make_immediate_payment" string="Make Payment" type="object" class="btn-success" 
                            invisible="state in ['paid', 'draft', 'cancelled']"/>
                    
                    <!-- Cancel Button -->
                    <button name="cancel_resource" string="Cancel" type="object" class="btn-danger" 
                            invisible="state in ['paid', 'draft', 'cancelled']"/>
                    
                    <!-- Reset to Draft Button -->
                    <button name="reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" 
                            invisible="state in ['draft', 'confirmed', 'loan', 'paid']"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,loan,paid,cancelled"/>                  
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="supplier_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount" readonly="1"/>
                            <field name="loan_amount" readonly="1"/>
                            <field name="payment_date" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Products/Fertilizers">
                                <field name="product_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="total_amount" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Resource Share Tree View -->
    <record id="view_custom_resource_share_tree" model="ir.ui.view">
        <field name="name">custom.resource.share.tree</field>
        <field name="model">custom.resource.share</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="loan_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="agro_company_menu" name="Agro Company" sequence="1"/>
    <menuitem id="menu_custom_resource_share" parent="agro_company_menu" name="Resource Share" sequence="2"/>

    <!-- Action for the Resource Share -->
    <record id="action_custom_resource_share" model="ir.actions.act_window">
        <field name="name">Resource Share</field>
        <field name="res_model">custom.resource.share</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_custom_resource_management" name="Resource Management" parent="menu_custom_resource_share" 
              action="action_custom_resource_share"/>
</odoo>
