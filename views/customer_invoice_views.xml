<odoo>
    

    <record id="view_customer_invoice_form" model="ir.ui.view">
        <field name="name">customer_invoice.form</field>
        <field name="model">vighnahar_agro.customer_invoice</field>
        <field name="arch" type="xml">
            <form string="Customer Invoice">
                <header>
                    <button name="action_create" type="object" string="Create" 
                                invisible="state != 'draft'" class="oe_highlight"/>
                
                    <button name="%(action_report_customer_invoice)d" string="Print" type="action" class="btn-primary"
                                    invisible="state != 'invoice' and state != 'downpayment'"/>
            
            
                    <button name="action_payment" type="object" string="Payment" 
                                invisible="state != 'invoice' and state != 'downpayment'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,invoice"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Paid" 
                            invisible="state != 'paid'" 
                            bg_color="text-bg-success" />
                    <group>
                        <group>
                            <field name="name"/>
                            
                            <field name="party_id"/>
                            <field name="invoice_type"/>

                        </group>
                        <group>
                            <field name="date"/>
                            <field name="warehouse_id"/>
                            <field name="payment_notification_date"/>
                            <!-- <field name="total_amount" readonly="1"/>
                            <field name="downpayment" readonly="1" invisible="downpayment == 0"/>
                            <field name="remaining_amount" readonly="1" invisible="downpayment == 0"/> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines">
                            <field name="customer_invoice_line_ids">
                                <tree editable="bottom">
                                    <field name="product_category_id" string="Product Category" domain="[('id', 'in', available_product_category_ids)]"/>
                                    <field name="product_id" string="Product"/>
                                    <field name="quantity" string="Quantity" decoration-danger="not is_available" decoration-success="is_available"/>
                                    <field name="uom_id" string="UOM"/>
                                    <field name="converted_quantity" string="Converted Quantity" optional="hide" decoration-danger="not is_available" decoration-success="is_available"/>
                                    <field name="converted_uom_id" string="Converted UOM" optional="hide"/>
                                    <field name="price" string="Unit Price"/>
                                    <field name="total" string="Total Price" readonly="1"/>
                                    <field name="uom_category_id" string="UOM Category" optional="hide"/>
                                    <field name="available_product_category_ids" optional="hide"/>
                                    <field name="is_available" optional="hide"/>
                                    
                                    
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <div style="text-align: right; padding-top: 20px;">
                        <div>Total: <strong><field name="total_amount"/></strong></div>
                        <div invisible="downpayment == 0">Downpayment: <strong><field name="downpayment"/></strong></div>
                        <div invisible="downpayment == 0">Remaining Amount: <strong><field name="remaining_amount"/></strong></div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_invoice_tree" model="ir.ui.view">
        <field name="name">customer_invoice.tree</field>
        <field name="model">vighnahar_agro.customer_invoice</field>
        <field name="arch" type="xml">
            <tree string="Customer Invoices">
                <field name="name" string="Name"/>
                <field name="party_id" string="Party"/>
                <field name="date" string="Date"/>
                <field name="invoice_type" string="Invoice Type"/>
                <field name="warehouse_id"/>
                <field name="total_amount" string="Total Amount"/>
                <field name="state" string="state"/>
            </tree>
        </field>
    </record>

    <record id="action_customer_invoice" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">vighnahar_agro.customer_invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_customer_invoice_tree"/>
    </record>

    <menuitem id="menu_customer_invoice" name="Customer Invoices" parent="menu_customer" action="action_customer_invoice"/>








    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">payment.form</field>
        <field name="model">vighnahar_agro.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <header>
                    <button name="action_confirm_payment" type="object" string="Confirm Payment" 
                                state="draft" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_invoice_id"/>
                            <field name = "party_id"/>
                            <field name="warehouse_id"/>
                            
                            
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="invoice_type"/>
                            <field name="amount"/>
                            
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Lines">
                            <field name="payment_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" string="Product"/>
                                    <field name="quantity" string="Quantity"/>
                                    <field name="uom_id" string="UOM"/>
                                    <field name="converted_quantity" string="Converted Quantity" optional="hide"/>
                                    <field name="converted_uom_id" string="Converted UOM" optional="hide"/>
                                    <field name="price" string="Unit Price"/>
                                    <field name="total" string="Total Price" readonly="1"/>
                                    <field name="uom_category_id" string="UOM Category" optional="hide"/>
                                    <field name="available_product_category_ids" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payment_tree" model="ir.ui.view">
        <field name="name">payment.tree</field>
        <field name="model">vighnahar_agro.payment</field>
        <field name="arch" type="xml">
            <tree string="Payments">
                <field name="name" string="Reference"/>
                <field name="customer_invoice_id" string="Customer Invoice"/>
                <field name = "party_id"/>
                <field name="warehouse_id"/>
                <field name="date" string="Date"/>
                <field name="amount" string="Amount"/>
                
                <field name="state" string="Status"/>
            </tree>
        </field>
    </record>


    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">vighnahar_agro.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_payment_tree"/>
    </record>


    <menuitem id="menu_payment" name="Payments" parent="menu_customer" action="action_payment"/>





     <!-- Downpayment Wizard -->
    <record id="view_downpayment_wizard_form" model="ir.ui.view">
        <field name="name">downpayment.wizard.form</field>
        <field name="model">vighnahar_agro.downpayment_wizard</field>
        <field name="arch" type="xml">
            <form string="Downpayment">
                <group>
                    <field name="customer_invoice_id" invisible="1"/>
                    <field name="invoice_type" readonly="1"/>
                    <field name="percentage" invisible = "invoice_type != 'percentage'"/>
                    <field name="fixed_amount" invisible = "invoice_type != 'fixed_amount'"/>
                    
                </group>
                <footer>
                    <button string="Payment" type="object" name="action_create_payment" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>