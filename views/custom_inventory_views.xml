<odoo>
    <data>

        <!-- View for custom.physical.inventory list -->
        <record id="view_custom_physical_inventory_list" model="ir.ui.view">
            <field name="name">custom.physical.inventory.list</field>
            <field name="model">custom.physical.inventory</field>
            <field name="arch" type="xml">
                <tree string="Physical Inventory">
                    <!-- Displaying Warehouse, Location, Product, Product Category, Quantity, UOM, Date -->
                    <field name="product_id"/>
                    <field name="product_category_id" optional="hide"/>
                    <field name="wh_loc_id"/>
                    <field name="quantity"/>
                    <field name="uom_id"/>
                </tree>
            </field>
        </record>

        <!-- Action to open the list view -->
        <record id="action_custom_physical_inventory" model="ir.actions.act_window">
            <field name="name">Physical Inventory</field>
            <field name="res_model">custom.physical.inventory</field>
            <field name="view_mode">tree</field>
            <field name="target">current</field>
        </record>

        <!-- Menu item for accessing physical inventory -->
        <menuitem id="menu_custom_inventory" name="Inventory" parent="agro_company_menu" sequence="4"/>
        <menuitem id="menu_custom_physical_inventory" name="Physical Inventory" parent="menu_custom_inventory" action="action_custom_physical_inventory" sequence="1"/>

        <!-- View for custom.physical.inventory list -->
        <record id="view_sub_inventory_list" model="ir.ui.view">
            <field name="name">sub.inventory.list</field>
            <field name="model">sub.inventory</field>
            <field name="arch" type="xml">
                <tree string="Sub Inventory">
                    <!-- Displaying Warehouse, Location, Product, Product Category, Quantity, UOM, Date -->
                    <field name="product_id"/>
                    <field name="product_category_id" optional="hide"/>
                    <field name="warehouse_id"/>
                    <field name="quantity"/>
                    <field name="uom_id"/>
                </tree>
            </field>
        </record>

        <!-- Action to open the list view -->
        <record id="action_sub_inventory" model="ir.actions.act_window">
            <field name="name">Sub Inventory</field>
            <field name="res_model">sub.inventory</field>
            <field name="view_mode">tree</field>
            <field name="target">current</field>
        </record>

        <menuitem id="menu_sub_inventory" name="Sub Inventory" parent="menu_custom_inventory" action="action_sub_inventory" sequence="3"/>

    </data>
</odoo>
