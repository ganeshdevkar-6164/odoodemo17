<odoo>
    <data>
        <record id="view_warehouse_tree" model="ir.ui.view">
            <field name="name">vighnahar.agro.warehouse.tree</field>
            <field name="model">vighnahar_agro.warehouse</field>
            <field name="arch" type="xml">
                <tree string="Warehouse">
                    <field name="name"/>
                    <field name="short_name"/>
                    <field name="company"/>
                    <field name="address"/>
                </tree>
            </field>
        </record>

        <record id="view_warehouse_form" model="ir.ui.view">
            <field name="name">vighnahar.agro.warehouse.form</field>
            <field name="model">vighnahar_agro.warehouse</field>
            <field name="arch" type="xml">
                <form string="Warehouse">
                    <sheet>
                        <group>
                            <label for="name" string="Warehouse Name"/>
                            <field name="name" class="oe_full_width"/>
                            <group>
                                <field name="short_name"/>
                            </group>
                            <group>
                                <field name="company"/>
                                <field name="address"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_vighnahar_agro_warehouse" model="ir.actions.act_window">
            <field name="name">Warehouses</field>
            <field name="res_model">vighnahar_agro.warehouse</field>
            <field name="view_mode">tree,form</field>
        </record>


        <menuitem id="menu_vighnahar_agro_warehouse" name="Warehouses" parent="menu_configuration" action="action_vighnahar_agro_warehouse"/>


        <record id="view_physical_inventory_form" model="ir.ui.view">
            <field name="name">physical_inventory.form</field>
            <field name="model">vighnahar_agro.physical_inventory</field>
            <field name="arch" type="xml">
                <form string="Physical Inventory">
                    <sheet>
                        <group>
                            <field name="warehouse_id"/> 
                        </group>
                        <notebook>
                            <page string="Inventory Lines">
                                <field name="inventory_line_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="product_category_id" string ="Product Category"/>
                                        <field name="product_id" string ="Product"/>
                                        <field name="quantity" string ="On Hand Quantity"/>
                                        <field name="uom_id" string ="UOM"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_physical_inventory_tree" model="ir.ui.view">
            <field name="name">physical_inventory.tree</field>
            <field name="model">vighnahar_agro.physical_inventory</field>
            <field name="arch" type="xml">
                <tree string="Physical Inventory">
                    <field name="warehouse_id"/>
                </tree>
            </field>
        </record>

        <record id="action_physical_inventory_form" model="ir.actions.act_window">
            <field name="name">Physical Inventory</field>
            <field name="res_model">vighnahar_agro.physical_inventory</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_physical_inventory_tree"/>
        </record>

        <menuitem id="menu_physical_inventory" name="Physical Inventory" parent="menu_inventory" action="action_physical_inventory_form" sequence="1"/>
    </data>
</odoo>