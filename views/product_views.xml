<odoo>
    <data>

        <record id="view_product_form" model="ir.ui.view">
            <field name="name">product.form</field>
            <field name="model">vighnahar_agro.product</field>
            <field name="arch" type="xml">
                <form string="Product">
                    <sheet>
                        <div name="button_box" position="inside" invisible="quantity == 0">
                            <div class="oe_stat_button btn-blue">
                                <i class="fa fa-cubes" style="margin-right: 8px;"></i> <!-- Added margin to create space -->
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value d-flex gap-1">
                                        <field name="quantity" nolabel="1" class="oe_inline"/>
                                        <field name="unit_of_measure_id" class="oe_inline" readonly="1"/>
                                    </span>
                                    <span class="o_stat_text">On Hand</span>
                                </div>
                            </div>
                        </div>

                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="can_be_sold" widget="boolean_toggle"/>
                                <field name="can_be_purchased" widget="boolean_toggle"/>
                                
                            </group>
                            <group>
                                <group>                                   
                                </group>
                                <group>
                                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}" />
                                </group>                               
                            </group>
                        </group>
                        <notebook>
                            <page string="General Information">
                                <form>
                                    <div class="o_row">
                                        <div class="o_col_4">
                                            <div class="form-group">
                                                <label for="product_type">Product Type</label>
                                                <field name="product_type" id="product_type"/>
                                            </div>
                                            <div class="form-group">
                                                <label for="uom_id">Unit of Measure</label>
                                                <field name="uom_id" id="uom_id"/>
                                            </div>
                                            <div class="form-group">
                                                <label for="define_date">Define Date</label>
                                                <field name="define_date" id="define_date"/>
                                            </div>
                                            <div class="form-group">
                                                <label for="category_id">Category</label>
                                                <field name="category_id" id="category_id" />
                                            </div>
                                        </div>
                                        <div class="o_col_4">
                                        </div>
                                        <div class="o_col_4">
                                            <div class="form-group">
                                                <label for="sales_price">Sales Price</label>
                                                <field name="sales_price" id="sales_price"/>
                                            </div>
                                            <div class="form-group">
                                                <label for="cost_price">Cost Price</label>
                                                <field name="cost_price" id="cost_price"/>
                                            </div>
                                            <div class="form-group">
                                                <label for="product_category_id">Product Category</label>
                                                <field name="product_category_id" id="product_category_id"/>
                                            </div>
                                        </div>
                                        <div class="o_col_4">
                                            <div class="form-group">
                                                <!-- <label for="uom_id">Unit of Measure</label> -->
                                                <field name="uom_id" id="uom_id"/>
                                            </div>
                                            <div class="form-group">
                                                <!-- <label for="uom_id">Unit of Measure</label> -->
                                                <field name="uom_id" id="uom_id"/>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </page>
                            <!-- <page string="Attributes Variants">
                                <field name="attribute_line_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="attributes_id"/>
                                        <field name="attributes_line_id"/>
                                    </tree>
                                </field>
                            </page> -->
                            <!-- <page string="Inventory">
                                <group>
                                    <group string = "Operations">   
                                        <field name="route_buy"/>
                                        <field name="route_dropship"/>       
                                    </group>
                                    <group string = "Logistics">
                                        <group>
                                            <field name="weight"/>
                                            <field name="volume"/>
                                        </group>
                                        <group>
                                            <field name="weight_uom_id"/>
                                            <field name="volume_uom_id" />
                                        </group>
                                    </group>
                                    <group string = "Traceability">
                                        <field name="tracking" widget="radio"/>                                           
                                    </group>
                                </group>
                            </page> -->
                            <page string="Purchase" invisible="can_be_purchased == False">
                                <field name="supplier_info_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="party_id" string = "Vendor"/>
                                        <field name="price" string = "Price"/>
                                        <field name="uom_id" string = "UOM" optional = "hide"/>
                                        <field name="min_qty" string = "Minimal Quantity" optional = "hide"/>
                                        <field name="delay" string = "Delivery Lead Time"/>
                                        <field name="company_id" optional = "hide"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Sales" invisible="can_be_sold == False">
                                <group>
                                    <group string="Upsell and Cross-Sell">
                                        <field name="optional_product_ids" widget="many2many_tags"
                                            placeholder="Recommended when adding to cart"/>
                                    </group>
                                    <group>
                                    </group>
                                </group>
                                
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_product_kanban" model="ir.ui.view">
            <field name="name">product.kanban</field>
            <field name="model">vighnahar_agro.product</field>
            <field name="priority">10</field> 
            <field name="arch" type="xml">
                <kanban class="o_product_kanban">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="define_date"/>
                    <field name="sales_price"/>
                    <field name="cost_price"/>
                    <field name="product_category_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_product_kanban_record">
                                <t t-if="record.image.raw_value">
                                    <field name="image" class="o_kanban_image_fill_left d-block" 
                                        widget="background_image" options="{'zoom': true, 'zoom_delay': 1000}"/>
                                </t>
                                <div t-else="" class="o_kanban_image_fill_left d-flex align-items-center justify-content-center bg-100 bg-gradient">
                                    <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                        <g fill="currentColor">
                                            <path d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                                            <circle cx="10" cy="5.5" r="4.5"/>
                                        </g>
                                    </svg>
                                </div>
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name" placeholder="Product Name"/>
                                            </strong>
                                            <!-- <span t-if="record.description.raw_value" class="o_kanban_record_subtitle">
                                                <field name="description"/>
                                            </span> -->
                                        </div>
                                    </div>
                                    <ul>
                                        <li t-if="record.description.raw_value" class="o_text_overflow">
                                            <i class="fa me-2 fa-info-circle text-primary" title="Description"/>
                                            <field name="description"/>
                                        </li>
                                        <li t-if="record.product_category_id.raw_value" class="o_force_ltr">
                                            <i class="fas me-2 fa-seedling" title="Product Category"/>
                                            <field name="product_category_id"/>
                                        </li>                                       
                                        <li t-if="record.sales_price.raw_value" class="o_force_ltr">
                                            <i class="fa fa-fw fa-inr text-primary" title="Sales Price"/>
                                            <field name="sales_price"/> INR
                                        </li>
                                        <li t-if="record.cost_price.raw_value" class="o_force_ltr">
                                            <i class="fa me-2 fa-calculator text-primary" title="Cost Price"/>
                                            <field name="cost_price"/> INR
                                        </li>
                                        <li t-if="record.define_date.raw_value" class="o_force_ltr">
                                            <i class="fas me-2 fa-calendar-alt" title="Define Date"/>
                                            <field name="define_date"/>
                                        </li>
                                        <li t-if="record.quantity.raw_value" class="o_force_ltr">
                                            <i class="me-2 fa-cubes" title="On Hand Quantity"/>
                                            <field name="quantity"/> kg
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <record id="view_product_tree" model="ir.ui.view">
            <field name="name">product.tree</field>
            <field name="model">vighnahar_agro.product</field>
            <field name="arch" type="xml">
                <tree string="Products">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="product_category_id"/>
                    <field name="define_date"/>
                    <field name="sales_price"/>
                    <field name="cost_price"/>
                    <field name = "quantity"/>
                    <field name="unit_of_measure_id"/>
                </tree>
            </field>
        </record>

        <record id="action_product_form" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">vighnahar_agro.product</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="view_id" ref="view_product_kanban"/>
        </record>

        <menuitem id="menu_product" name="Products" parent="menu_vighnahar_agro" action="action_product_form" sequence="1"/>
        
    </data>
</odoo>
