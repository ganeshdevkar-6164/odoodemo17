<odoo>
    <record id="view_credit_memo_form" model="ir.ui.view">
        <field name="name">credit_memo.form</field>
        <field name="model">vighnahar_agro.credit_memo</field>
        <field name="arch" type="xml">
            <form string="Credit Memo">
                <header>
                    <button name="action_confirm_order" type="object" string="Sale" 
                                invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_credit" type="object" string="Credit" 
                                invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,credit,sales_order"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="party_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Supply Lines">
                            <field name="supply_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" string="Product"/>
                                    <field name="quantity" string="Quantity"/>
                                    <field name="price" string="Price"/>
                                    <field name="total" string="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_credit_memo_tree" model="ir.ui.view">
        <field name="name">credit_memo.tree</field>
        <field name="model">vighnahar_agro.credit_memo</field>
        <field name="arch" type="xml">
            <tree string="Credit Memo">
                <field name="name"/>
                <field name="party_id"/>
                <field name="date"/>
                <field name="total_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_credit_memo" model="ir.actions.act_window">
        <field name="name">Credit Memo</field>
        <field name="res_model">vighnahar_agro.credit_memo</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_credit_memo_tree"/>
    </record>

    
    <menuitem id="menu_credit_memo" name="Credit Memo" parent="menu_vighnahar_agro" action="action_credit_memo" sequence="3"/>
</odoo>