<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Labor Invoice Form View -->
        <record id="view_labor_payment_form" model="ir.ui.view">
            <field name="name">labor_payment.form</field>
            <field name="model">vighnahar_agro.labor_payment</field>
            <field name="arch" type="xml">
                <form string="Labor Payment">
                    <header>
                        <button name="action_pay" string="Pay" type="object"
                        class="oe_highlight" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="party_id" domain="[('party_type', '=', 'labor')]" required="1"/>
                                <field name="date"/>
                                <field name="bank_account_id" invisible="payment_method not in ('bank', 'online')" />
                            </group>

                            <group>
                                <field name="payment_method"/>
                                <field name="amount"/>
                                <field name="journal_id"/>       
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Labor Invoice Tree View -->
        <record id="view_labor_payment_tree" model="ir.ui.view">
            <field name="name">labor_payment.tree</field>
            <field name="model">vighnahar_agro.labor_payment</field>
            <field name="arch" type="xml">
                <tree string="Labor Invoices">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="party_id"/>
                    <field name="payment_method"/>
                    
                    <field name="journal_id"/>
                    <field name="amount" sum="amount"/>
                    <field name="state" widget="badge" decoration-success="state == 'paid'"
                                                   decoration-info="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <!-- Action for Labor Invoice -->
        <record id="action_labor_payment" model="ir.actions.act_window">
            <field name="name">Labor Payment</field>
            <field name="res_model">vighnahar_agro.labor_payment</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Item for Labor Invoice -->
        <menuitem id="menu_labor_payment" name="Labor Payment" parent="menu_supplier" action="action_labor_payment"/>



        <record id="view_labor_payment_qr_wizard_form" model="ir.ui.view">
            <field name="name">vighnahar_agro.labor_payment_qr_wizard.form</field>
            <field name="model">vighnahar_agro.labor_payment_qr_wizard</field>
            <field name="arch" type="xml">
                <form string="Labor Payment QR Code">
                    <group>
                        <field name="qr_code_image" widget="image" readonly="1"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_done" string="Done" type="object" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Labor Payment Bank Wizard Form View -->
        <record id="view_labor_payment_bank_wizard_form" model="ir.ui.view">
            <field name="name">vighnahar_agro.labor_payment_bank_wizard.form</field>
            <field name="model">vighnahar_agro.labor_payment_bank_wizard</field>
            <field name="arch" type="xml">
                <form string="Labor Payment Bank Details">
                    <group>
                        <field name="bank_name"/>
                        <field name="account_number"/>
                        <field name="branch"/>
                        <field name="ifsc_code"/>
                        <field name="bank_holder_name"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_done" string="Done" type="object" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
