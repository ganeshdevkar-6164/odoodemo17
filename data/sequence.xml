<odoo>
    <data>

        <record id = "seq_customer_invoice" model = "ir.sequence">
            <field name="name">Customer Invoice Sequence</field>
            <field name="code">vighnahar_agro.customer_invoice</field>
            <field name="prefix">CI-</field>
            <field name="padding">5</field>
            <field name="company_id" eval = "False"/>
        </record>

        <record id = "seq_supplier_invoice" model = "ir.sequence">
            <field name="name">Supplier Invoice Sequence</field>
            <field name="code">vighnahar_agro.supplier_invoice</field>
            <field name="prefix">SI-</field>
            <field name="padding">5</field>
            <field name="company_id" eval = "False"/>
        </record>
        

        
     
        <record id = "seq_standard_invoice" model = "ir.sequence">
            <field name="name">Standard Invoice Sequence</field>
            <field name="code">vighnahar_agro.standard_invoice</field>
            <field name="prefix">STI-</field>
            <field name="padding">5</field>
            <field name="company_id" eval = "False"/>
        </record>


    </data>
</odoo>