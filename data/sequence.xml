<odoo>
    <data>

        <record id = "seq_customer_invoice" model = "ir.sequence">
            <field name="name">Customer Invoice Sequence</field>
            <field name="code">vighnahar_agro.customer_invoice</field>
            <field name="prefix">CINV-</field>
            <field name="padding">5</field>
            <field name="company_id" eval = "False"/>
        </record>

        <record id = "seq_supplier_invoice" model = "ir.sequence">
            <field name="name">Supplier Invoice Sequence</field>
            <field name="code">vighnahar_agro.supplier_invoice</field>
            <field name="prefix">SINV-</field>
            <field name="padding">5</field>
            <field name="company_id" eval = "False"/>
        </record>
        

        <record id = "seq_customer_payment" model = "ir.sequence">
            <field name="name">Payment</field>
            <field name="code">vighnahar_agro.payment</field>
            <field name="prefix">CPAY-</field>
            <field name="padding">5</field>
            <field name="company_id" eval = "False"/>
        </record>

        <record id="seq_payment" model="ir.sequence">
            <field name="name">Supplier Payment Sequence</field>
            <field name="code">vighnahar_agro.supplier_payment</field>
            <field name="prefix">SPAY-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record> 

    </data>
</odoo>