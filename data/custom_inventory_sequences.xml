        <!-- Sales Order Sequence -->
        <record id="sales_order_custom_sequence" model="ir.sequence">
            <field name="name">Sales Order Custom</field>
            <field name="code">sales.order.custom.sequence</field>
            <field name="prefix">SO/</field>
